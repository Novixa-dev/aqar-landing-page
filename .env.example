# ==============================================================================
# Novixa Aqar B2B Landing Page — Environment Template (.env.example)
# Copy to .env.local for local development. Never commit real secret values.
# ==============================================================================

# Canonical public origin for SEO metadata, hreflang, sitemap, robots.txt, and OG cards.
# Example: https://aqar.novixa.dev
NEXT_PUBLIC_SITE_URL=https://aqar.novixa.dev

# Primary and secondary demo URLs (centralized config overrides if needed)
NEXT_PUBLIC_AQAR_PRIMARY_DEMO_URL=https://aqar-demo2.novixa.dev/
NEXT_PUBLIC_AQAR_BRANDED_DEMO_DEXAL_URL=https://aqar-demo.dexal.net/
NEXT_PUBLIC_AQAR_BRANDED_DEMO_RUSU_URL=https://aqar-demo2.novixa.dev/
NEXT_PUBLIC_NOVIXA_HOME_URL=https://novixa.dev

# Public contact channels (client-visible)
NEXT_PUBLIC_CONTACT_EMAIL=hello@novixa.dev
# Optional verified WhatsApp number in international digits without "+" (e.g. 967771234567).
# Leave empty unless verified; when empty, the UI hides WhatsApp buttons rather than linking to a placeholder.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Server-side mail transport (Resend or SMTP)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Novixa Aqar <no-reply@novixa.dev>"
NOVIXA_CONTACT_EMAIL=hello@novixa.dev

# Server-side lead storage:
# - 'memory' for local/E2E testing
# - 'file' to persist leads to .leads-data/leads.jsonl on a single-node server
# - Or set LEAD_WEBHOOK_URL to forward validated leads to an external CRM/n8n webhook
LEADS_STORE=memory
LEAD_WEBHOOK_URL=
