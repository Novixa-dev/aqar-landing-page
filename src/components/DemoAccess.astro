---
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';
import { site } from '../../site.config';

/**
 * The seeded demo logins, published deliberately so a prospect can get inside
 * the role panels without waiting for a sales call. They are demo-only
 * accounts on fictional data — `site.demoAccess.publishLogins` turns the whole
 * block off if that ever stops being acceptable.
 */
interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale).demoAccess;
const { accounts, password } = site.demoAccess;
---

<div class="mx-auto mt-14 max-w-3xl rounded-2xl border border-slate-700 bg-slate-900/50 p-6 text-start sm:p-8">
  <div class="flex items-start gap-3">
    <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-brand/15 text-brand-bright">
      <Icon name="users" class="h-4 w-4" />
    </span>
    <div>
      <h3 class="font-bold text-white">{d.title}</h3>
      <p class="mt-1 text-sm leading-relaxed text-slate-400">{d.lede}</p>
    </div>
  </div>

  <ul class="mt-6 grid gap-4 sm:grid-cols-2">
    {accounts.map((account) => (
      <li class="rounded-xl border border-slate-700 bg-ink-deep p-5">
        <p class="text-sm font-bold text-white">{account.role[locale]}</p>
        <p class="mt-0.5 text-xs text-slate-500">{account.note[locale]}</p>

        <dl class="mt-4 space-y-2 text-sm">
          <div class="flex items-center gap-2">
            <dt class="sr-only">Email</dt>
            <Icon name="mail" class="h-3.5 w-3.5 shrink-0 text-slate-500" />
            <dd dir="ltr" class="truncate font-mono text-xs text-slate-300">{account.email}</dd>
          </div>
          <div class="flex items-center gap-2">
            <dt class="text-xs text-slate-500">{d.passwordLabel}</dt>
            <dd dir="ltr" class="rounded bg-slate-800 px-2 py-0.5 font-mono text-xs text-slate-300">{password}</dd>
          </div>
        </dl>

        <a
          href={account.panel}
          target="_blank"
          rel="noopener"
          class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-bright transition hover:text-white"
        >
          {d.openPanel}
          <Icon name="external" class="h-3.5 w-3.5" />
        </a>
      </li>
    ))}
  </ul>

  <p class="mt-5 text-xs text-slate-500">{d.note}</p>
</div>
