---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Wraps a product screenshot in a minimal browser chrome. The point is the
 * opposite of a "floating UI mockup": the frame plus a real URL bar tells the
 * viewer this is an actual running page they can go and open themselves.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  url: string;
  href?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}
const {
  src,
  alt,
  url,
  href,
  widths = [640, 960, 1280, 1440],
  sizes = '(min-width: 1024px) 60rem, 100vw',
  loading = 'lazy',
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'div';
const linkProps = href ? { href, target: '_blank', rel: 'noopener' } : {};
---

<Tag
  {...linkProps}
  class={`shot block overflow-hidden rounded-xl border border-slate-300/60 bg-white ${href ? 'transition hover:border-brand/50' : ''} ${className}`}
>
  <div class="flex items-center gap-2 border-b border-slate-200 bg-slate-100 px-3 py-2">
    <span class="flex gap-1.5" aria-hidden="true">
      <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-slate-300"></span>
    </span>
    <span
      dir="ltr"
      class="mx-auto max-w-[70%] truncate rounded bg-white px-3 py-1 text-[11px] font-medium text-slate-500"
      >{url}</span
    >
  </div>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} format="webp" quality={82} class="w-full" />
</Tag>
