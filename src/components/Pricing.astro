---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';
import { site, whatsappLink, mailtoLink } from '../../site.config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale).pricing;
const cta = t(locale).finalCta;

const quoteHref = whatsappLink(cta.whatsappMessage) ?? mailtoLink(cta.emailSubject);
---

<Section id="pricing" eyebrow={d.eyebrow} title={d.title} lede={d.lede} tone="tint">
  <div class="grid gap-6 lg:grid-cols-5">
    <!-- Price card -->
    <div class="rounded-2xl border border-slate-200 bg-ink-deep p-8 text-white lg:col-span-2">
      <p class="text-sm font-semibold text-slate-400">{d.fromLabel}</p>
      <!-- Each figure is its own LTR run so the currency reads correctly, while
           the row itself follows the page direction and stays aligned to the
           card's reading edge in both locales. -->
      <p class="mt-2 flex items-baseline gap-3">
        <span dir="ltr" class="tabular text-5xl font-extrabold tracking-tight">${site.pricing.amountUsd}</span>
        <span dir="ltr" class="text-sm text-slate-400">≈ {site.pricing.amountSar.toLocaleString('en-US')} SAR</span>
      </p>
      <p class="mt-1 text-sm text-slate-400">{d.perLabel}</p>

      <p class="mt-5 rounded-lg border border-slate-700 bg-slate-900/60 px-4 py-3 text-xs leading-relaxed text-slate-400">
        {d.note}
      </p>

      <h3 class="mt-8 text-xs font-bold uppercase tracking-[0.16em] text-slate-500">{d.variesTitle}</h3>
      <ul class="mt-3 space-y-2">
        {d.variesBy.map((item) => (
          <li class="flex gap-2.5 text-sm text-slate-300">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-brand-bright" aria-hidden="true"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>

      <div class="mt-8 space-y-3">
        {quoteHref ? (
          <a
            href={quoteHref}
            target="_blank"
            rel="noopener"
            class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand px-6 py-3.5 font-bold text-white transition hover:bg-brand-bright"
          >
            {d.cta}
          </a>
        ) : (
          <p class="rounded-xl border border-dashed border-slate-600 px-6 py-3.5 text-center text-sm text-slate-400">
            {cta.pending}
          </p>
        )}
        <a
          href={site.links.demo}
          target="_blank"
          rel="noopener"
          class="flex w-full items-center justify-center gap-2 rounded-xl border border-slate-600 px-6 py-3.5 font-semibold text-white transition hover:border-slate-400"
        >
          {d.ctaSecondary}
          <Icon name="external" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <!-- Includes -->
    <div class="grid gap-6 lg:col-span-3">
      <div class="rounded-2xl border border-slate-200 bg-white p-8">
        <h3 class="font-bold text-ink">{d.includesTitle}</h3>
        <ul class="mt-5 grid gap-3.5 sm:grid-cols-2">
          {d.includes.map((item) => (
            <li class="flex gap-3">
              <Icon name="check" class="mt-1 h-4 w-4 shrink-0 text-verified" />
              <span class="text-[15px] leading-relaxed text-slate-700">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white p-8">
        <h3 class="font-bold text-ink">{d.addonsTitle}</h3>
        <ul class="mt-5 flex flex-wrap gap-2.5">
          {d.addons.map((item) => (
            <li class="rounded-lg bg-slate-100 px-3.5 py-2 text-sm font-medium text-slate-700">{item}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</Section>
