---
import Logo from './Logo.astro';
import { t, type Locale } from '../i18n';
import { site } from '../../site.config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const home = locale === 'ar' ? '/' : '/en';
---

<header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur-md">
  <nav class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8" aria-label={d.nav.cta}>
    <a href={home} class="flex shrink-0 items-center gap-2.5">
      <Logo class="h-8 w-8" />
      <span class="flex flex-col leading-none">
        <span class="text-[15px] font-bold tracking-tight text-ink">{site.brand.name[locale]}</span>
        <span class="mt-0.5 text-[10px] font-medium uppercase tracking-widest text-slate-500">Novixa</span>
      </span>
    </a>

    <ul class="mx-auto hidden items-center gap-1 lg:flex">
      {d.nav.items.map((item) => (
        <li>
          <a
            href={item.href}
            class="rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition hover:bg-slate-100 hover:text-ink"
            >{item.label}</a
          >
        </li>
      ))}
    </ul>

    <div class="ms-auto flex items-center gap-2 lg:ms-0">
      <a
        href={d.nav.switchHref}
        hreflang={locale === 'ar' ? 'en' : 'ar'}
        class="rounded-lg border border-slate-200 px-2.5 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-slate-300 hover:text-ink"
        >{d.nav.switchTo}</a
      >
      <a
        href={site.links.demo}
        target="_blank"
        rel="noopener"
        class="hidden rounded-lg bg-ink px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand sm:inline-block"
        >{d.nav.cta}</a
      >
      <button
        type="button"
        id="nav-toggle"
        aria-controls="nav-mobile"
        aria-expanded="false"
        class="rounded-lg p-2 text-slate-600 transition hover:bg-slate-100 lg:hidden"
      >
        <span class="sr-only">{d.nav.menuOpen}</span>
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </nav>

  <div id="nav-mobile" hidden class="border-t border-slate-200 bg-white lg:hidden">
    <ul class="mx-auto max-w-7xl px-4 py-3 sm:px-6">
      {d.nav.items.map((item) => (
        <li>
          <a href={item.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-100"
            >{item.label}</a
          >
        </li>
      ))}
      <li class="pt-2">
        <a
          href={site.links.demo}
          target="_blank"
          rel="noopener"
          class="block rounded-lg bg-ink px-3 py-2.5 text-center text-sm font-semibold text-white"
          >{d.nav.cta}</a
        >
      </li>
    </ul>
  </div>
</header>

<script>
  // ~10 lines of JS for the mobile menu. The rest of the page ships none.
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('nav-mobile');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(panel.hidden));
    // Same-page anchors don't reload, so the panel has to be closed explicitly.
    panel.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });
  }
</script>
