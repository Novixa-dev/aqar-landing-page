---
/** Inline icon set. Stroke icons unless noted; `check`/`brand` marks are filled. */
interface Props { name: keyof typeof paths; class?: string }
const { name, class: className = 'h-5 w-5' } = Astro.props;

const paths = {
  check: '<path d="m4 12.5 5 5L20 6.5" stroke-linecap="round" stroke-linejoin="round"/>',
  minus: '<path d="M5 12h14" stroke-linecap="round"/>',
  alert:
    '<path d="M12 9v4m0 4h.01M10.3 3.9 2.4 17.5A2 2 0 0 0 4.1 20.5h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" stroke-linecap="round" stroke-linejoin="round"/>',
  arrow: '<path d="M5 12h14m0 0-5-5m5 5-5 5" stroke-linecap="round" stroke-linejoin="round"/>',
  external:
    '<path d="M14 5h5v5M19 5l-8 8M18 14v4a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h4" stroke-linecap="round" stroke-linejoin="round"/>',
  chevron: '<path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>',
  whatsapp:
    '<path d="M3.5 20.5 4.8 16A8 8 0 1 1 8 19.2l-4.5 1.3Z" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 9.5c0 3 2.5 5.5 5.5 5.5.6 0 1-.5 1-1l-1.4-.8-1 .9a5.6 5.6 0 0 1-2.2-2.2l.9-1L11 9.5c-.5 0-1 .4-1 1Z" stroke-linejoin="round"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6 8.5-6" stroke-linecap="round"/>',
  github:
    '<path d="M9 19c-4 1.2-4-2.2-5.5-2.7M15 21v-3.4c0-1 .1-1.4-.5-2 2.3-.3 4.5-1.2 4.5-5a3.9 3.9 0 0 0-1-2.7 3.6 3.6 0 0 0-.1-2.7s-.9-.3-2.9 1.1a10 10 0 0 0-5 0C7.9 4.2 7 4.5 7 4.5a3.6 3.6 0 0 0-.1 2.7 3.9 3.9 0 0 0-1 2.7c0 3.8 2.2 4.7 4.5 5-.6.6-.6 1.2-.5 2V21" stroke-linecap="round" stroke-linejoin="round"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/>',
  layers:
    '<path d="m12 3 9 5-9 5-9-5 9-5Z" stroke-linejoin="round"/><path d="m3.5 12.5 8.5 4.7 8.5-4.7" stroke-linecap="round" stroke-linejoin="round"/>',
  shield: '<path d="M12 3 4.5 6v6c0 4 3.2 7.4 7.5 9 4.3-1.6 7.5-5 7.5-9V6L12 3Z" stroke-linejoin="round"/>',
  chart: '<path d="M4 20V10m5 10V4m5 16v-7m5 7V8" stroke-linecap="round"/>',
  code: '<path d="m9 8-5 4 5 4m6-8 5 4-5 4" stroke-linecap="round" stroke-linejoin="round"/>',
  users:
    '<circle cx="9" cy="8" r="3.2"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0M16 5.4a3.2 3.2 0 0 1 0 5.2m1.2 2.2a5.5 5.5 0 0 1 3.3 5" stroke-linecap="round"/>',
  sparkle:
    '<path d="M12 3.5 13.8 9l5.5 1.8-5.5 1.8L12 18l-1.8-5.4L4.7 10.8 10.2 9 12 3.5Z" stroke-linejoin="round"/>',
} as const;
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  aria-hidden="true"
  set:html={paths[name]}
/>
