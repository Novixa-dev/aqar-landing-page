---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';
import { site, whatsappLink, mailtoLink } from '../../site.config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale).partners;
const cta = t(locale).finalCta;

const href = whatsappLink(cta.partnerWhatsappMessage) ?? mailtoLink(cta.partnerEmailSubject);
---

<Section id="partners" eyebrow={d.eyebrow} title={d.title} lede={d.lede} tone="light">
  {site.partners.publishCommissionRate && (
    <div class="mb-8 flex flex-col items-center gap-4 rounded-2xl border-2 border-verified/25 bg-verified-soft/30 p-7 sm:flex-row sm:p-8">
      <!-- One LTR run: a separate `%` span gets reordered away from its number
           by the bidi algorithm in the Arabic locale. -->
      <p dir="ltr" class="flex shrink-0 items-baseline text-verified">
        <span class="tabular text-5xl font-extrabold tracking-tight">{site.partners.commissionPercent}</span>
        <span class="text-2xl font-extrabold">%</span>
      </p>
      <div>
        <p class="font-bold text-ink">{d.commissionLabel}</p>
        <p class="mt-0.5 text-[15px] leading-relaxed text-slate-600">{d.commissionNote}</p>
      </div>
    </div>
  )}

  <ol class="grid gap-6 md:grid-cols-3">
    {d.steps.map((step, i) => (
      <li class="relative rounded-2xl border border-slate-200 bg-white p-7">
        <span
          class="tabular inline-flex h-9 w-9 items-center justify-center rounded-full bg-ink text-sm font-bold text-white"
          >{i + 1}</span
        >
        <h3 class="mt-4 font-bold text-ink">{step.title}</h3>
        <p class="mt-1.5 text-[15px] leading-relaxed text-slate-600">{step.body}</p>
      </li>
    ))}
  </ol>

  <p class="mt-8 max-w-3xl text-[15px] leading-relaxed text-slate-600">{d.audience}</p>

  {href && (
    <p class="mt-6">
      <a
        href={href}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-xl border-2 border-ink px-6 py-3 font-bold text-ink transition hover:bg-ink hover:text-white"
      >
        {d.cta}
        <Icon name="arrow" class="h-4 w-4 rtl:rotate-180" />
      </a>
    </p>
  )}
</Section>
