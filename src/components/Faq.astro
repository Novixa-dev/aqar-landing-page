---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale).faq;

// FAQPage structured data, generated from the same copy shown on the page so
// the two can never drift apart.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: d.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Section id="faq" eyebrow={d.eyebrow} title={d.title} tone="tint" align="center">
  <div class="mx-auto max-w-3xl divide-y divide-slate-200 border-y border-slate-200">
    {d.items.map((item) => (
      <details class="group">
        <summary class="flex items-start gap-4 py-5 text-start">
          <span class="flex-1 font-bold text-ink">{item.q}</span>
          <Icon name="chevron" class="faq-chevron mt-1 h-4 w-4 shrink-0 text-slate-400 transition-transform" />
        </summary>
        <p class="pb-6 pe-8 text-[15px] leading-relaxed text-slate-600">{item.a}</p>
      </details>
    ))}
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Section>
