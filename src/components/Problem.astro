---
import Section from './Section.astro';
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale).problem;
---

<Section id="problem" eyebrow={d.eyebrow} title={d.title} lede={d.lede} tone="light">
  <ul class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {d.items.map((item, i) => (
      <li class="border-t border-slate-200 pt-6">
        <span class="tabular text-xs font-bold text-slate-400">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-2 text-lg font-bold text-ink">{item.title}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-slate-600">{item.body}</p>
      </li>
    ))}
  </ul>
</Section>
